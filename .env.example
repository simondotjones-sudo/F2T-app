# New installation credentials only. Set real values in Netlify Functions scope.
# Configure the F2T platform administrator only in the production deploy context.
F2T_PLATFORM_ADMIN_EMAIL=
# Unique password, 16–128 characters. Mark secret in Netlify. Never commit credentials.
F2T_PLATFORM_ADMIN_PASSWORD=
# Set to this new project's HTTPS origin after Netlify creates it.
PRIMARK_APP_URL=

# Both switches default to disabled when absent. Keep disabled during migration.
LMS_BACKGROUND_JOBS=disabled
LMS_EMAIL_DELIVERY=disabled
# Enable in Functions scope and redeploy before any private data import.
# This also pauses interactive application access. Disable only after validation.
LMS_MIGRATION_HOLD=disabled
# Leave sender credentials empty during initial setup.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound
